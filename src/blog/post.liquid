---
pagination:
  data: blog.localPosts
  size: 1
  alias: post
permalink: /blog/{{ post.id }}/
layout: layouts/base.liquid
title: "{{ post.title }}"
zennCss: true
eleventyComputed:
  title: "{{ post.title }}"
---
<article class="post-detail">
  <a href="/blog" class="back-link">&larr; Blog</a>
  <header>
    <h1>{{ post.title | escape }}</h1>
    <div class="meta">
      <span>{{ post.date | formatDate }}  &middot;  {{ post.readTime | escape }}</span>
    </div>
    {% if post.tags.size > 0 %}
    <div class="tags">
      {% for tag in post.tags %}
      <a href="/blog?tag={{ tag | url_encode | escape }}" class="tag">{{ tag | escape }}</a>
      {% endfor %}
    </div>
    {% endif %}
    <div class="header-divider"></div>
  </header>
  <div class="znc">{{ post.html }}</div>
</article>
